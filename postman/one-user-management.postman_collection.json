{
  "info": {
    "name": "one-user-management API",
    "description": "Toate endpoint-urile din UserController. Porneste aplicatia (mvn spring-boot:run), apoi ruleaza intai 'GET all users' ca sa se populeze {{userId}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Command (POST / PUT / DELETE)",
      "item": [
        {
          "name": "POST create user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Rares\",\n  \"lastName\": \"Dumitru\",\n  \"email\": \"rares.dumitru@gmail.com\",\n  \"password\": \"parola999\",\n  \"age\": 31\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "201 Created + header Location. Salveaza id-ul in variabila {{userId}}."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('userId', body.id);",
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Location header prezent', () => pm.expect(pm.response.headers.get('Location')).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
